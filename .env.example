# dry-exec Developer Environment Configuration

# Log level for observability and execution tracing (DEBUG, INFO, WARNING, ERROR)
DRY_EXEC_LOG_LEVEL=INFO

# Ephemeral memory mapping bounds (in bytes)
DRY_EXEC_DEFAULT_MEMORY_LIMIT=67108864

# Transparent network proxy interception timeout (in milliseconds)
DRY_EXEC_PROXY_TIMEOUT_MS=500

# Kernel isolation backend override (auto, linux_native, mock_ffi)
DRY_EXEC_BACKEND=auto

# Colorized Rich terminal output (true / false)
DRY_EXEC_COLOR_OUTPUT=true
